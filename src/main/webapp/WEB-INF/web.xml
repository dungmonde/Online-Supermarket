    <welcome-file-list><welcome-file>view/customer/CustomerHomeUI3.jsp</welcome-file></welcome-file-list>
    <error-page><error-code>500</error-code><location>/WEB-INF/view/common/ErrorUI3.jsp</location></error-page>
</web-app>
